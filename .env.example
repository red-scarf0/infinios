# Public base URL of the site. Used for metadata and absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact form delivery (/api/contact -> sales@infinios.com)
#
# Provider-neutral SMTP: point these at whichever service actually sends the
# mail (Microsoft 365, Google Workspace, SES, Postmark, ...). Without them the
# route answers 503 and the form shows a failure message — it never pretends
# to have sent anything.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "true" forces TLS on connect. Defaults to true when SMTP_PORT is 465.
SMTP_SECURE=
# Envelope sender. Defaults to SMTP_USER.
CONTACT_FROM_EMAIL=
# Where enquiries land. Defaults to sales@infinios.com.
CONTACT_TO_EMAIL=sales@infinios.com
