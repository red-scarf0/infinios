# Copy to .env.local for development. Never commit a file with real values —
# .gitignore excludes every .env* except this template.

# Public base URL of the site. Used for metadata and absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Contact form delivery (/api/contact -> Resend -> sales@infinios.com)
#
# Without RESEND_API_KEY the route answers 503 and the form shows a failure
# message — it never pretends to have sent anything.
#
# All three are server-only. None is prefixed NEXT_PUBLIC_, so none is ever
# bundled into client JavaScript. In Vercel, set them under
# Project Settings -> Environment Variables for the Production environment
# (and Preview, if the form should work on preview deployments).
# ---------------------------------------------------------------------------

# Required. Server-side Resend API key (starts with "re_"). The real value goes
# in .env.local and in Vercel only — never in this file, never in the
# repository. A send-only key is enough.
RESEND_API_KEY=

# The sender. Must be an address on website.infinios.com — the domain verified
# in Resend. The shared onboarding@resend.dev test sender only reaches the
# Resend account owner and must NOT be used in production.
#
# Note the sending domain (website.infinios.com) is deliberately different from
# the recipient domain (infinios.com); only the sending domain needs SPF/DKIM
# in Resend.
CONTACT_FROM_EMAIL=noreply@website.infinios.com

# Where enquiries land. Defaults to sales@infinios.com.
CONTACT_TO_EMAIL=sales@infinios.com
